{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Eightfold-Code/eightfold-armoury/blob/main/schemas/registry.schema.json",
  "title": "Eightfold Armoury Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "updated", "skins", "collections"],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference"
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "skins": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/skinId"
      },
      "additionalProperties": {
        "$ref": "#/$defs/skinEntry"
      }
    },
    "collections": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/skinId"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/skinId"
        },
        "uniqueItems": true
      }
    }
  },
  "$defs": {
    "skinId": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
      "minLength": 1,
      "maxLength": 64
    },
    "skinEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "version", "source", "manifest", "compatibility"],
      "properties": {
        "id": {
          "$ref": "#/$defs/skinId"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "branch", "commit"],
          "properties": {
            "repository": {
              "type": "string",
              "pattern": "^[^/\\s]+/[^/\\s]+$"
            },
            "branch": {
              "type": "string",
              "pattern": "^skin/[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
            },
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          }
        },
        "manifest": {
          "type": "string",
          "const": "eightfold.skin.json"
        },
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["eightfoldHarness"],
          "properties": {
            "eightfoldHarness": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
