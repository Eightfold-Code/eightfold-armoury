{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Eightfold-Code/eightfold-armoury/blob/main/schemas/skin.schema.json",
  "title": "Eightfold Skin Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "name",
    "version",
    "description",
    "entry",
    "tokens",
    "presets",
    "compatibility",
    "presentationOnly"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference"
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
      "minLength": 1,
      "maxLength": 64
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 280
    },
    "entry": {
      "type": "string",
      "const": "theme.json"
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["colors", "typography"],
      "properties": {
        "colors": {
          "$ref": "#/$defs/relativePath"
        },
        "typography": {
          "$ref": "#/$defs/relativePath"
        }
      }
    },
    "presets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/relativePath"
      },
      "uniqueItems": true
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eightfoldHarness"],
      "properties": {
        "eightfoldHarness": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "presentationOnly": {
      "const": true
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\s]+$"
    }
  }
}
